{
    "taskDefinitionArn": "arn:aws:ecs:us-east-1:000000000000:task-definition/usms-enrolment:2",
    "containerDefinitions": [
        {
            "name": "enrolment-api",
            "image": "public.ecr.aws/nginx/nginx:stable-alpine",
            "portMappings": [
                {
                    "containerPort": 80,
                    "hostPort": 0,
                    "protocol": "tcp"
                }
            ],
            "essential": true,
            "environment": [
                {
                    "name": "USMS_SERVICE",
                    "value": "enrolment"
                },
                {
                    "name": "USMS_BUCKET",
                    "value": "usms-student-data"
                },
                {
                    "name": "AWS_REGION",
                    "value": "us-east-1"
                },
                {
                    "name": "USMS_LOG_LEVEL",
                    "value": "info"
                }
            ]
        }
    ],
    "family": "usms-enrolment",
    "taskRoleArn": "arn:aws:iam::000000000000:role/usms-ecs-task-role",
    "executionRoleArn": "arn:aws:iam::000000000000:role/usms-ecs-exec-role",
    "networkMode": "awsvpc",
    "revision": 2,
    "status": "ACTIVE",
    "compatibilities": [
        "FARGATE"
    ],
    "requiresCompatibilities": [
        "FARGATE"
    ],
    "cpu": "256",
    "memory": "1024"
}
